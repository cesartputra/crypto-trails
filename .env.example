# Disalin ke .env di folder main.py; dibaca otomatis, environment shell lebih utama.
ETHERSCAN_API_KEY=
ETHERSCAN_BASE_URL=https://api.etherscan.io/v2/api
# Hanya Ethereum; chain lain memakai allowlist fallback masing-masing di services/chains.py.
ETHERSCAN_FALLBACK_EXPLORER_URL=https://eth.blockscout.com/api
# BSC memerlukan key Etherscan V2; TRON hanya skenario sintetis.
# Terisi: Solscan Pro API v2. Kosong: Solana Mainnet RPC publik.
# Key dikirim melalui header token hanya ke host Solscan resmi.
SOLSCAN_API_KEY=
SOLSCAN_BASE_URL=https://pro-api.solscan.io/v2.0
# Hop 4-6 semua chain live; key hanya dibaca server, tidak dikirim lewat UI.
# Default Free di kode: 1 transaksi/kategori/alamat; 6 percobaan termasuk retry,
# kumulatif per trace dan perluasan manual; reservasi 2000 kredit, bukan jaminan tagihan.
# Biaya memakai x-credits-consumed bila ada, selain itu estimasi konservatif.
# Jeda global satu proses: 1,2 detik setelah respons; satu retry 429 mengikuti
# Retry-After <=10 detik bila anggaran/deadline cukup, selain itu hasil parsial.
# 402/403 dan batas kelanjutan mempertahankan bukti primer; 401/500/malformed fatal tersanitasi.
# Akun Free: 100000 kredit/bulan; soft 100 dan hard 1000 kredit/detik, bukan request.
# Request terisolasi dapat melampaui soft limit; biaya aktual bisa melebihi reservasi.
# Akuntansi lokal tidak mencakup klien lain atau beberapa worker/proses server.
# https://developers.cryptoapis.io/v-2.2024-12-12/RESTapis/general-information/data-flow-limiting
CRYPTOAPIS_API_KEY=
CRYPTOAPIS_BASE_URL=https://rest.cryptoapis.io
