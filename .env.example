# Disalin ke .env di folder main.py; dibaca otomatis (environment shell lebih utama).
# Kosong: mode Live memakai Blockscout Ethereum Mainnet publik, bukan data simulasi.
ETHERSCAN_API_KEY=
ETHERSCAN_BASE_URL=https://api.etherscan.io/v2/api
ETHERSCAN_FALLBACK_EXPLORER_URL=https://eth.blockscout.com/api
# V1 dapat dikonfigurasi sebagai https://api.etherscan.io/api untuk kompatibilitas;
# provider dapat menolak V1 yang sudah dihentikan. Gunakan V2 sebagai default.
